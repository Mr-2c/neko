{
"version": 1.0,
"case": {
    "mesh_file": "box_out.nmsh",
    "output_at_end": false,
    "output_boundary": false,
    "output_checkpoints": false,
    "time": {
        "end_time": 0.08,
        "timestep": 0.01,
        "variable_timestep": false
    },
    "numerics": {
        "time_order": 3,
        "polynomial_order": 4,
        "dealias": true
    },
    "fluid": {
        "scheme": "pnpn",
        "Re": 2800.0,
        "initial_condition": { "type": "expression", "value": ["(1-y*y) + 0.3*sin(x)*cos(2*z)", "0.3*cos(x)*sin(2*z)*(1-y*y)", "0.3*sin(2*x)*cos(z)*(1-y*y)"] },
        "velocity_solver": {
            "type": "cg",
            "preconditioner": { "type": "jacobi" },
            "projection_space_size": 0,
            "absolute_tolerance": 1e-7,
            "max_iterations": 800
        },
        "pressure_solver": {
            "type": "gmres",
            "preconditioner": { "type": "hsmg" },
            "projection_space_size": 0,
            "absolute_tolerance": 1e-8,
            "max_iterations": 800
        },
        "boundary_conditions": [
            { "type": "velocity_value", "value": [1.0, 0.0, 0.0], "zone_indices": [1] },
            { "type": "outflow", "zone_indices": [2] },
            { "type": "no_slip", "zone_indices": [3, 4] }
        ],
        "output_control": "never"
    }
}
}
