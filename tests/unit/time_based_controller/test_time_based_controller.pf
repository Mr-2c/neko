module test_time_based_controller
contains
!> Test the constructor
@test
subroutine test_init()
  use pfunit
  use time_based_controller, only : time_based_controller_t
  use time_state, only : time_state_t
  use num_types, only : rp
  implicit none

  type(time_based_controller_t) ctrl

  call ctrl%init(0.0_rp, 1.0_rp, "simulationtime", 10.0_rp)
  @assertEqual(ctrl%start_time, 0.0_rp, tolerance=1e-6_rp)
  @assertEqual(ctrl%end_time, 1.0_rp, tolerance=1e-6_rp)
  @assertEqual(ctrl%time_interval, 10.0_rp, tolerance=1e-6_rp)
  @assertEqual(ctrl%frequency, 0.1_rp, tolerance=1e-6_rp)
  @assertEqual(ctrl%nsteps, 0)

  call ctrl%init(0.0_rp, 1.0_rp, "nsamples", 10.0_rp)
  @assertEqual(ctrl%start_time, 0.0_rp, tolerance=1e-6_rp)
  @assertEqual(ctrl%end_time, 1.0_rp, tolerance=1e-6_rp)
  @assertEqual(ctrl%time_interval, 0.1_rp, tolerance=1e-6_rp)
  @assertEqual(ctrl%frequency, 10.0_rp, tolerance=1e-6_rp)
  @assertEqual(ctrl%nsteps, 0)

  call ctrl%init(0.0_rp, 1.0_rp, "tsteps", 10.0_rp)
  @assertEqual(ctrl%start_time, 0.0_rp, tolerance=1e-6_rp)
  @assertEqual(ctrl%end_time, 1.0_rp, tolerance=1e-6_rp)
  @assertEqual(ctrl%time_interval, 0.0_rp, tolerance=1e-6_rp)
  @assertEqual(ctrl%frequency, 0.0_rp, tolerance=1e-6_rp)
  @assertEqual(ctrl%nsteps, 10)
end subroutine test_init

!> Test assignment
@test
subroutine test_assign()
  use pfunit
  use time_based_controller, only : time_based_controller_t
  use num_types, only : rp
  implicit none

  type(time_based_controller_t) ctrl1
  type(time_based_controller_t) ctrl2

  call ctrl1%init(0.0_rp, 1.0_rp, "simulationtime", 10.0_rp)
  ctrl2 = ctrl1
  @assertEqual(ctrl1%end_time, ctrl2%end_time, tolerance=1e-6_rp)
  @assertEqual(ctrl1%time_interval, ctrl2%time_interval, tolerance=1e-6_rp)
  @assertEqual(ctrl1%frequency, ctrl2%frequency, tolerance=1e-6_rp)
  @assertEqual(ctrl1%nsteps, ctrl2%nsteps)
  @assertEqual(ctrl1%nexecutions, ctrl2%nexecutions)
  @assertEqual(ctrl1%control_value, ctrl2%control_value)
  @assertEqual(ctrl1%control_mode, ctrl2%control_mode)

end subroutine test_assign

!> Test check simulationtime
@test
subroutine test_check_simulationtime()
  use pfunit
  use time_based_controller, only : time_based_controller_t
  use num_types, only : rp
  use time_state, only : time_state_t
  implicit none

  type(time_based_controller_t) ctrl
  type(time_state_t) :: time

  call ctrl%init(0.0_rp, 10.0_rp, "simulationtime", 1.0_rp)
  time%t = 0.0_rp
  time%tstep = 0
  time%dt = 0.0_rp

  ! Expect true on first execution
  @assertEqual(ctrl%check(time), .true.)
  call ctrl%register_execution()
  time%t = 1.1_rp

  @assertEqual(ctrl%check(time), .true.)
  call ctrl%register_execution()
  time%t = 1.5_rp

  @assertEqual(ctrl%check(time), .false.)
  time%t = 1.99_rp
  time%dt = 0.5_rp

  @assertEqual(ctrl%check(time), .true.)
  call ctrl%register_execution()
  time%t = 2.01_rp
  time%dt = 0.5_rp
  @assertEqual(ctrl%check(time), .false.)

  time%t = 3.01_rp
  @assertEqual(ctrl%check(time), .true.)
  call ctrl%register_execution()

end subroutine test_check_simulationtime

!> Test check nsamples
@test
subroutine test_check_nsamples()
  use pfunit
  use time_based_controller, only : time_based_controller_t
  use num_types, only : rp
  use time_state, only : time_state_t
  implicit none

  type(time_based_controller_t) ctrl
  type(time_state_t) :: time

  call ctrl%init(0.0_rp, 10.0_rp, "nsamples", 10.0_rp)

  time%t = 0.0_rp
  ! Expect true on first execution
  @assertEqual(ctrl%check(time), .true.)
  call ctrl%register_execution()
  time%t = 1.1_rp

  @assertEqual(ctrl%check(time), .true.)
  call ctrl%register_execution()
  time%t = 1.5_rp

  @assertEqual(ctrl%check(time), .false.)

end subroutine test_check_nsamples

!> Test check tsteps
@test
subroutine test_check_tsteps()
  use pfunit
  use time_based_controller, only : time_based_controller_t
  use num_types, only : rp
  use time_state, only : time_state_t
  implicit none

  type(time_based_controller_t) ctrl
  type(time_state_t) :: time

  call ctrl%init(0.0_rp, 10.0_rp, "tsteps", 10.0_rp)
  time%tstep = 0

  ! Expect true on first execution
  @assertEqual(ctrl%check(time), .true.)
  call ctrl%register_execution()

  time%tstep = 10
  @assertEqual(ctrl%check(time), .true.)
  call ctrl%register_execution()

  time%tstep = 15
  @assertEqual(ctrl%check(time), .false.)

end subroutine test_check_tsteps

!> Test register
@test
subroutine test_register()
  use pfunit
  use time_based_controller, only : time_based_controller_t
  use num_types, only : rp
  implicit none

  type(time_based_controller_t) ctrl

  call ctrl%init(0.0_rp, 1.0_rp, "simulationtime", 10.0_rp)
  call ctrl%register_execution()
  @assertEqual(ctrl%nexecutions, 1)

end subroutine test_register

!> Test the time until the next scheduled execution
@test
subroutine test_time_to_next()
  use pfunit
  use time_based_controller, only : time_based_controller_t
  use time_state, only : time_state_t
  use num_types, only : rp
  implicit none

  type(time_based_controller_t) :: ctrl
  type(time_state_t) :: time

  call time%init(0.0_rp, 1.0_rp, 0.01_rp)

  ! Nothing to land on for tsteps and never
  call ctrl%init(0.0_rp, 1.0_rp, "tsteps", 10.0_rp)
  @assertTrue(ctrl%time_to_next(time, 0.01_rp) .ge. huge(0.0_rp))
  call ctrl%free()
  call ctrl%init(0.0_rp, 1.0_rp, "never", 0.0_rp)
  @assertTrue(ctrl%time_to_next(time, 0.01_rp) .ge. huge(0.0_rp))

  ! Executed at 0, 0.1 and 0.2: the next is at 0.3
  call ctrl%free()
  call ctrl%init(0.0_rp, 1.0_rp, "simulationtime", 0.1_rp)
  ctrl%nexecutions = 3
  time%t = 0.25_rp
  @assertEqual(ctrl%time_to_next(time, 0.01_rp), 0.05_rp, tolerance=1e-12_rp)

  ! Due now at the start, so executed at the coming step anyway: the one
  ! after it is landed on
  ctrl%nexecutions = 0
  time%t = 0.0_rp
  @assertEqual(ctrl%time_to_next(time, 0.01_rp), 0.1_rp, tolerance=1e-12_rp)

  ! An interval shorter than the step, or than the shortest interval to
  ! land on, is not landed on
  @assertTrue(ctrl%time_to_next(time, 0.2_rp) .ge. huge(0.0_rp))
  @assertTrue(ctrl%time_to_next(time, 0.01_rp, 0.15_rp) .ge. huge(0.0_rp))

  ! A scheduled time at the end is landed on, one after it never executes
  ctrl%nexecutions = 10
  time%t = 0.95_rp
  @assertEqual(ctrl%time_to_next(time, 0.01_rp), 0.05_rp, tolerance=1e-12_rp)
  ctrl%nexecutions = 11
  @assertTrue(ctrl%time_to_next(time, 0.01_rp) .ge. huge(0.0_rp))

  ! The schedule is anchored at the start time of the case
  call time%init(0.5_rp, 2.0_rp, 0.01_rp)
  call ctrl%free()
  call ctrl%init(0.5_rp, 2.0_rp, "nsamples", 6.0_rp)
  ctrl%nexecutions = 2
  time%t = 0.7_rp
  @assertEqual(ctrl%time_to_next(time, 0.01_rp), 0.3_rp, tolerance=1e-12_rp)

end subroutine test_time_to_next

!> Test the counter set on a restart, which uses the step taken last
@test
subroutine test_set_counter()
  use pfunit
  use time_based_controller, only : time_based_controller_t
  use time_state, only : time_state_t
  use num_types, only : rp
  implicit none

  type(time_based_controller_t) :: ctrl
  type(time_state_t) :: time

  ! The placeholder step of a variable time step is a whole time unit
  call time%init(0.0_rp, 1.0_rp, 1.0_rp)
  time%t = 0.0546_rp
  time%dtlag(1) = 1.0e-3_rp
  call ctrl%init(0.0_rp, 1.0_rp, "simulationtime", 0.0107_rp)
  call ctrl%set_counter(time)
  ! Executed at 0, 0.0107, ..., 0.0535
  @assertEqual(ctrl%nexecutions, 6)

end subroutine test_set_counter

end module test_time_based_controller
